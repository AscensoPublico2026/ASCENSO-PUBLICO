# Configuracion del monitor CNSC
# Copia este archivo como .env y llena los valores

# Email donde llegarán las alertas
ALERT_EMAIL=ascensopublico@gmail.com

# Credenciales para enviar emails (usa una cuenta de Gmail con App Password)
SMTP_EMAIL=tu-email-remitente@gmail.com
SMTP_PASSWORD=tu-app-password-de-gmail

# Intervalo de revision en minutos (default: 60)
CHECK_INTERVAL_MINUTES=60

# Palabras clave para buscar en PDFs y contenido
KEYWORDS=fecha de aplicación,pruebas escritas,cronograma,ejes temáticos,citación,convocatoria,resolución,inscripción,OPEC,manual de funciones,Corpomojana,DIAN,Territorial
